{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospectos-serverless",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prospectos-staging-d1",
      "database_id": "7155ca1d-72c7-4097-a361-7f1ca8e57eb6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "a737a3e399514847853b0afbdc70d9b6"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TARGET_MONTHLY_COST": "$0.00 USD",
    "GROQ_API_URL": "https://api.groq.com/openai/v1/chat/completions",
    "GEMINI_API_URL": "https://generativelanguage.googleapis.com/v1beta",
    "JWT_SECRET": "prospectos-cf-zero-cost-master-secret-2026"
  }
}

