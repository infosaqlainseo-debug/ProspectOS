# ==============================================================================
# PROSPECTOS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `backend/.env` for local/Docker execution.
# NEVER commit production .env files containing real secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SECURITY
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # "development", "staging", or "production"
LOG_LEVEL=INFO                         # "DEBUG", "INFO", "WARNING", "ERROR"
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# For local development outside Docker:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prospectos
# For Docker Compose internal networking:
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/prospectos

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=prospectos
POSTGRES_CONTAINER=prospectos_db

# ------------------------------------------------------------------------------
# 3. REDIS & BACKGROUND QUEUE (Redis 7)
# ------------------------------------------------------------------------------
# For local development outside Docker:
REDIS_URL=redis://localhost:6379/0
# For Docker Compose internal networking:
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. LLM PROVIDER (Anthropic Claude)
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic                 # "anthropic" (preferred) or "openai"
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. SEO & DOMAIN AUTHORITY METRICS
# ------------------------------------------------------------------------------
# Ahrefs API v3 (Required for live Domain Rating lookups)
AHREFS_API_KEY=your_ahrefs_api_key_here

# Optional Providers (Left blank for graceful safe bypass; non-fabricated NULLs)
MOZ_API_KEY=
MOZ_ACCESS_ID=
SEMRUSH_API_KEY=
MAJESTIC_API_KEY=
SIMILARWEB_API_KEY=

# ------------------------------------------------------------------------------
# 6. OUTREACH & EMAIL SAFETY CONTROLS (MODE B LOCKDOWN)
# ------------------------------------------------------------------------------
# In Phase 1 and current production, EMAIL_PROVIDER must remain "none".
# Outbound socket dispatch is blocked; reports and messages are simulated safely.
EMAIL_PROVIDER=none                    # "none" (required for safe mode), "mock", "gmail", "smtp"

# Placeholders for future authorized outreach (do not populate in Phase 1):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 7. BACKUP & DISASTER RECOVERY
# ------------------------------------------------------------------------------
BACKUP_DIR=backups                     # Directory path for PostgreSQL .dump archives
BACKUP_RETENTION_DAYS=14               # Automated retention pruning window (days)

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Exposed to the browser by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
# For production reverse proxy:
# NEXT_PUBLIC_API_URL=https://app.grokxseo.online
